(@doc (sn input)
  (@desc "Add one discounted observation (r,s evidence at base rate a from source sigma with trust p) to a statement's kernel evidence cell.")
  (@params ((@param "Statement sid")
            (@param "Positive evidence r")
            (@param "Negative evidence s")
            (@param "Base rate a")
            (@param "Source sigma")
            (@param "Composed trust/discount p")))
  (@return "Statement sid"))

(@doc (sn opinion)
  (@desc "Current opinion view of a statement's evidence cell under k=W=2 (J 3.11).")
  (@params ((@param "Statement sid")))
  (@return "(Opinion b d u a)"))

(@doc (sn expect)
  (@desc "Projected probability P = b + a*u of a statement (J 3.2).")
  (@params ((@param "Statement sid")))
  (@return "Projected probability"))

(@doc (sn above)
  (@desc "Threshold filter on projected probability, usable inside match pipelines.")
  (@params ((@param "Statement sid")
            (@param "Threshold")))
  (@return "True or False"))

(@doc (sn evidence)
  (@desc "Raw evidence cell view of a statement.")
  (@params ((@param "Statement sid")))
  (@return "(Ev r s a)"))

(@doc (sn deduce)
  (@desc "SL deduction (J 9.41 + K-correction) of premise statement through edge statement, else-branch synthesized from marginals (SLN 8.4).")
  (@params ((@param "Premise statement sid")
            (@param "Edge statement sid")
            (@param "Consequent base rate a_y")))
  (@return "(Opinion b d u a)"))

(@doc (sn disjoint)
  (@desc "Stamp-level evidence-overlap guard: True when two statements share no stamps (receipts are direct observations; stamps are their union-inherited closure over derivations).")
  (@params ((@param "First statement sid")
            (@param "Second statement sid")))
  (@return "True or False"))

(@doc discover!
  (@desc "The discovery query (4.2): statements the model BELIEVES but never observed — has a proof node and zero direct receipts. Patterns are canonicalized, so they match over sense atoms.")
  (@params ((@param "Typed SH pattern with MeTTa variables in arg positions")))
  (@return "Answer triple per purely-derived match"))

(@doc goal!
  (@desc "Register a goal: desire stored as the base rate of an evidence-free goal cell (reads back exactly; outcome evidence accumulates later). Option: :desire d.")
  (@params ((@param "Typed SH goal tree")
            (@param "Option group, e.g. (:desire 0.9)")))
  (@return "Goal sid"))

(@doc why-not!
  (@desc "Explain disbelief or absence of belief: negative evidence with its sources, or insufficient support with the current view.")
  (@params ((@param "Typed SH pattern of the statement to explain")))
  (@return "(because-not ...) explanation per match"))

(@doc (sn desire)
  (@desc "Current desire value of a goal cell (projected probability).")
  (@params ((@param "Goal sid")))
  (@return "Desire in [0,1]"))

(@doc (sn view)
  (@desc "Read-time view of a statement: epistemic statements are uncertainty-maximised at read (SLN 9.4); aleatory and structural read their plain opinion.")
  (@params ((@param "Statement sid")))
  (@return "(Opinion b d u a)"))

(@doc (sn dc)
  (@desc "Degree of conflict between the current views of two statements (J 4.63): |dP| * c1 * c2 — fires only on confident, opposed beliefs.")
  (@params ((@param "First statement sid")
            (@param "Second statement sid")))
  (@return "Conflict degree in [0,1]"))

(@doc (sn marginal)
  (@desc "Live base rate of a term: projected probability of its prevalence cell (a vacuous cell seeded at prior a reads back exactly a; unseeded terms default to 0.5).")
  (@params ((@param "Typed SH term")))
  (@return "Base rate"))

(@doc (sn marginal!)
  (@desc "Seed a term's prior base rate from the ontology: an evidence-free input at rate a on the term's prevalence cell.")
  (@params ((@param "Typed SH term")
            (@param "Prior base rate a")))
  (@return "Term sid"))

(@doc (sn derive!)
  (@desc "One forward step: superpose the |- rule KB over distinct pairs of supported statements, those with a receipt or a proof. Strong rules materialize K-corrected conclusions with marginal-pulled base rates under the Frechet guard; weak rules fuse bounded pseudo-observations (w <= 1). Proof nodes dedup refirings; receipts are inherited.")
  (@params ())
  (@return "(stmt sid term) per firing, or empty"))

(@doc (sn cycles)
  (@desc "Bounded forward-derivation loop: run derive! n times to a fixed point or budget (the v0 control cycle; priority queues and attention come with the frontier).")
  (@params ((@param "Number of cycles")))
  (@return "Unit"))

(@doc (sn ingest-all!)
  (@desc "Ingest every root hb tree in the space (3.1): peel/canonicalize, intern with provenance, structural compound edges, attitude auto-claims with deixis, receipt-gated evidence at w = trust * p_parse.")
  (@params ((@param "Source sigma")
            (@param "Source trust")
            (@param "Parse confidence p_parse")))
  (@return "Ingested statement sids"))

(@doc (sn ingest!)
  (@desc "Ingest one root hb tree by edge id (3.1 single-edge form).")
  (@params ((@param "hb edge id")
            (@param "Source sigma")
            (@param "Source trust")
            (@param "Parse confidence p_parse")))
  (@return "Ingested statement sid or empty"))

(@doc believe!
  (@desc "Author one statement: canonicalize, intern sn facts, write the receipt (the claim record), add discounted evidence. Options in either surface -- grouped clauses ((evidence 8.0 0.0) (source \"maria\") (quant \"most\") (claim) ...) preferred, flat :keys (:evidence r s, :rate a, :source sigma, :trust p, :domain d, :kind k, :occ t, :quantifier q, :hedge h, :claim) accepted through one normalizer; unknown clauses land in the open (sn meta ...) channel.")
  (@params ((@param "Typed SH statement tree")
            (@param "Option group, e.g. (:evidence 9.0 1.0 :source \"maria\")")))
  (@return "Statement sid"))

(@doc ask!
  (@desc "Query supported statements, those with a receipt or a proof, by typed pattern with role-typed holes; answers as (: opinion proof (stmt sid term)) triples. An interned reference that asserts nothing, such as a conditional's endpoint or a query, is no answer.")
  (@params ((@param "Typed SH pattern with MeTTa variables in arg positions")))
  (@return "Answer triple per match"))

(@doc why!
  (@desc "Explain a derived statement: proof kind plus premises with opinions, rendered in English via hb en.")
  (@params ((@param "Typed SH pattern of the statement to explain")))
  (@return "(because ded|abd (premise-english opinion) (premise-english opinion))"))

(@doc (sn rw-list)
  (@desc "Reflectivity (R5): the list of registered rewrite-rule names -- the system reading its own rule set. Rules are (sn rw NAME CLASS prem1 prem2 concl) data rows; the driver matches a bound premise pair against the stored patterns and fires truth per CLASS (ded-shape | weak-abd-shape | weak-ind-shape | structural).")
  (@params ())
  (@return "(name ...)"))

(@doc (sn rw-typed)
  (@desc "Chainer-compatibility view (R5): each registry row projected as a typed constructor (: (rw NAME) (-> (stmt prem1) (stmt prem2) (stmt concl))), consumable by the generic synthesize/sbc chainers. On demand only -- never materialized.")
  (@params ())
  (@return "Typed constructor per registered row"))

(@doc (sn subgoals!)
  (@desc "Practical reasoning (R2): walk =/> procedural links into a registered goal and re-register antecedent actions as subgoals at discounted desire expect(edge)*desire(goal), gated by the decision threshold. Control-side, not truth (SLN 3.9 -- desire is P(g)).")
  (@params ((@param "Goal sid")))
  (@return "Subgoal sids registered above threshold"))

(@doc (sn sim2inh!)
  (@desc "Similarity->inheritance conversion (R1; SLN 9.8): mint both inheritance directions from a symmetric similarity statement on demand, at the 2J/(1+J) identity, each with its own (s2i _ _) proof node.")
  (@params ((@param "Similarity statement sid")))
  (@return "Inheritance statement sids"))

(@doc (sn or-view)
  (@desc "Read-time disjunction composition (R4; J 7.3): the OR of two statements' current views, computed on demand (the disjunction sentence stores ONE opinion; this composes the members).")
  (@params ((@param "First statement sid") (@param "Second statement sid")))
  (@return "(Opinion b d u a)"))

(@doc (sn sym-edges!)
  (@desc "Symmetric mirror (R0; SLN 9.8.4): for a symmetric-licensed relation, mint the inverse statement carrying the full view (f preserved, w=c), proof-deduped, stamps shared so the mirror cannot graft back.")
  (@params ((@param "Statement sid")))
  (@return "Mirrored statement sid or empty"))

(@doc (sn mood-of)
  (@desc "SH speech-act mood of a statement (the full-form metadata the canonical proposition normalizes away): v declarative (default when unmarked), i interrogative -> query/hole, j imperative -> goal, n nominal/copular, e existential -> instance. The complete original SH tree rides in (sn sh <sid> ...); a question, command and assertion of one proposition share a sid but keep distinct moods.")
  (@params ((@param "Statement sid")))
  (@return "Mood symbol"))

(@doc (sn temporal!)
  (@desc "Budgeted step-6 temporal pass (C1; SLN 9.3): over occ-carrying statements, close gap<=interval-gap occ runs into intervals (oPIEC-lite) and fold each event cell into the eternal cell at lambda^(now-t) (project->eternalize->fuse), idempotent per (Event canon t). No-op unless temporal-cells mode is on.")
  (@params ((@param "Frontier budget") (@param "Current tick now")))
  (@return "Touched statement sids"))

(sn (function input))
(sn (function opinion))
(sn (function expect))
(sn (function above))
(sn (function evidence))
(sn (function deduce))
(sn (function disjoint))
(sn (function view))
(sn (function dc))
(sn (function marginal))
(sn (function marginal!))
(sn (function derive!))
(sn (function cycles))
(sn (function believe!))
(sn (function ask!))
(sn (function why!))
(sn (function discover!))
(sn (function goal!))
(sn (function why-not!))
(sn (function desire))
(sn (function ingest!))
(sn (function ingest-all!))
(sn (function rw-list))
(sn (function rw-typed))

;; SNARS data constructors (phantom-call lint exemptions; see core.metta).
(mb-lint-data-head Opinion)
(mb-lint-data-head Ev)
(mb-lint-data-head Fr)
(mb-lint-data-head Peeled)
(mb-lint-data-head Goal)
(mb-lint-data-head OUTCOME)
(mb-lint-data-head Notes)
(mb-lint-data-head unknown-opt)
(mb-lint-data-head queue)
(mb-lint-data-head chain)
(mb-lint-data-head Conds)
(mb-lint-data-head CondX)
(mb-lint-data-head Inconsistent)
(mb-lint-data-head Sub)
(mb-lint-data-head Event)
(mb-lint-data-head PfNode)
(mb-lint-data-head PfLeaf)
(sn (function why-draw!))

;; ---- module aggregator: the monolith now lives in snars/*.metta ----
;; kernel first (its load-time bangs consult kernel.pl and import the
;; evidence-cell predicates); everything after is order-insensitive
;; definitions, kept in reading order.
!(import! &self snars/kernel)
!(import! &self snars/config)
!(import! &self snars/units)
!(import! &self snars/terms)
!(import! &self snars/truth)
!(import! &self snars/trust)
!(import! &self snars/intern)
!(import! &self snars/rules)
!(import! &self snars/similarity)
!(import! &self snars/conditional)
!(import! &self snars/ordering)
!(import! &self snars/rulekit)
!(import! &self snars/sbc)
!(import! &self snars/miner)
!(import! &self snars/compile)
!(import! &self snars/forget)
!(import! &self snars/meta)
!(import! &self snars/authoring)
!(import! &self snars/derive)
!(import! &self snars/temporal)
!(import! &self snars/ingest)
